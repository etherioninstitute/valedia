//@version=5
// PAPER. Boilerplate-shaped gates (inverse flip, MDD, session, RiskMTip, kill).
// Engine: TopG_5M_Scalp. Not Waddah_1H_Anchor. Not Trendhoo_45M. No webhook.
// Passphrase is a sentinel. Replace it in the TradingView alert dialog only.
strategy("DAVIDDTECH TopG_5M_Scalp paper", overlay=true, pyramiding=0, process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1)

// ponytail: PDF long = G-Channel green AND HEMA volume flow > 0 and above its baseline.
// ponytail: PDF short = G-Channel red AND flow declining and under that baseline. No published lengths.
// ponytail: G-Channel length 100 is Alex Grover's public default. Holt alpha 0.8 / beta 0.2 and EMA 9 baseline are public stand-ins.
// ponytail: fixed stop 1.0% is a placeholder. PDF says tight fixed-percent and does not give the percent.
// ponytail: limit is stop distance x 1.3 (PDF RnRTip floor of 1.3-2.05) and still alerts action exit. No tp1/tp2/breakeven string.
// ponytail: portfolio_risk 0.2 is the PDF 20% allocation. Run the chart on 5m.

invFlip = input.bool(false, "Inverse flip")
kill = input.bool(false, "Kill switch")
maxPercDd = input.float(15.0, "maxPercDdTip", minval=0.1, step=0.1)
useSession = input.bool(false, "Session filter")
sess = input.session("0800-1600", "Session")
riskMTip = input.float(1.5, "RiskMTip", minval=0.1, step=0.1)
gLen = input.int(100, "G-Channel length", minval=1)
hemaAlpha = input.float(0.8, "HEMA alpha", minval=0.01, maxval=0.99, step=0.01)
hemaBeta = input.float(0.2, "HEMA beta", minval=0.01, maxval=0.99, step=0.01)
flowLen = input.int(9, "Flow baseline", minval=1)
stopPct = input.float(1.0, "Fixed stop %", minval=0.05, step=0.05)
rnrFloor = input.float(1.3, "RnRTip floor", minval=0.1, step=0.05)

ALERT_ENTRY = '{"passphrase":"PASTE_PASSPHRASE_IN_TV_ALERT","timestamp":"{{timenow}}","strategy_id":"TopG_5M_Scalp","ticker":"{{ticker}}","action":"entry","subaccount":"paper","entry_price":{{close}},"volume":{{strategy.order.contracts}},"portfolio_risk":0.2}'

f_alert(action) =>
    str.replace(ALERT_ENTRY, '"action":"entry"', '"action":"' + action + '"')

var float gA = na
var float gB = na
gA := math.max(close, nz(gA[1])) - (nz(gA[1]) - nz(gB[1])) / gLen
gB := math.min(close, nz(gB[1])) + (nz(gA[1]) - nz(gB[1])) / gLen
bool crossUp = gB[1] < close[1] and gB > close
bool crossDn = gA[1] < close[1] and gA > close
int sinceDn = ta.barssince(crossDn)
int sinceUp = ta.barssince(crossUp)
bool gBull = sinceDn <= sinceUp

float signedVol = close > close[1] ? volume : close < close[1] ? -volume : 0.0
var float hemaLvl = na
var float hemaTr = na
float prevLvl = hemaLvl[1]
float prevTr = hemaTr[1]
if na(prevLvl)
    hemaLvl := signedVol
    hemaTr := 0.0
else
    hemaLvl := hemaAlpha * signedVol + (1.0 - hemaAlpha) * (prevLvl + nz(prevTr))
    hemaTr := hemaBeta * (hemaLvl - prevLvl) + (1.0 - hemaBeta) * nz(prevTr)
float flow = hemaLvl + hemaTr
float flowBase = ta.ema(flow, flowLen)
bool flowLong = flow > 0 and flow > flowBase
bool flowShort = flow < flowBase and flow < flow[1]

rawLong = gBull and flowLong
rawShort = not gBull and flowShort
wantLong = invFlip ? rawShort : rawLong
wantShort = invFlip ? rawLong : rawShort

var float peakEq = na
peakEq := math.max(nz(peakEq, strategy.initial_capital), strategy.equity)
ddPct = peakEq > 0 ? (peakEq - strategy.equity) / peakEq * 100.0 : 0.0
inSess = not useSession or not na(time(timeframe.period, sess))
allow = not kill and ddPct < maxPercDd and inSess and not na(gA) and not na(flow)

float stopDist = close * stopPct / 100.0
float qty = stopDist > 0 ? (strategy.equity * riskMTip / 100.0) / stopDist : 1.0

if allow and wantLong and not wantShort and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty=qty, alert_message=f_alert("entry"))
if allow and wantShort and not wantLong and strategy.position_size == 0
    strategy.entry("S", strategy.short, qty=qty, alert_message=f_alert("entry"))

if strategy.position_size > 0 and wantShort
    strategy.close("L", alert_message=f_alert("exit"))
if strategy.position_size < 0 and wantLong
    strategy.close("S", alert_message=f_alert("exit"))

if strategy.position_size > 0
    float eL = strategy.position_avg_price
    strategy.exit("XL", from_entry="L", stop=eL * (1.0 - stopPct / 100.0), limit=eL * (1.0 + stopPct / 100.0 * rnrFloor), alert_message=f_alert("exit"))
if strategy.position_size < 0
    float eS = strategy.position_avg_price
    strategy.exit("XS", from_entry="S", stop=eS * (1.0 + stopPct / 100.0), limit=eS * (1.0 - stopPct / 100.0 * rnrFloor), alert_message=f_alert("exit"))

plot((gA + gB) / 2.0, "G mid", color=gBull ? color.lime : color.red)
