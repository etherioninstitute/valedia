# runtime state, ledgers and caches never enter history
state/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
.env
.env.*
*.pem
*.key
# generated repo map (rebuild with tools/repo_map.py ensure)
.repo-map/generations/
.repo-map/build.lock
tools/repomix-runtime/node_modules/
# local artefacts
artifacts/
.DS_Store
# research loop runtime state (the journal itself and the reviews are kept)
journal/paper_state.json
journal/paper_state.json.tmp
journal/kill_switch.json
# the owner's hand-written permission to trade real money: never committed, never created by code
config/webull_live.json
# the owner's go-live checklist and stake ladder: they carry his name (confirmed_by); never committed
config/go_live.json
config/ladder.json
# research desk working rooms (approved notes in research/library/ are kept)
research/desk/

# the Webull SDK writes whole requests, headers included, to this file in the working directory
webull_trade_sdk.log
*.log

# the Webull SDK stores its access token in plain text under the working directory
/conf/
