"""Alpha Intelligence Engine — Valedia ASI
Self-improving intelligence layer. Runs daily to find edges BEFORE the crowd.

Sources:
  1. SEC EDGAR: Insider buys/sells, 13F whale holdings, Form 4 filings
  2. Unusual options: High volume/OI ratio = smart money positioning
  3. Whale wallet tracking: On-chain large transfers
  4. Inversion thinking: "What if consensus is wrong?"
  5. Performance tracking: Log every prediction, measure accuracy, adapt weights

(c) GOATWORTHY Post LLC.
"""
import os, json, requests, sys
from datetime import datetime, timezone, timedelta
import numpy as np

HEADERS = {"User-Agent": "Valedia-ASI research@goatworthy.com"}

def get_insider_buys(days=7):
    """SEC EDGAR: Recent insider purchases (Form 4). Insiders buying = bullish signal."""
    try:
        url = "https://efts.sec.gov/LATEST/search-index?q=%22Purchase%22&dateRange=custom"
        # Use EDGAR full-text search for recent Form 4 purchases
        end = datetime.now(timezone.utc)
        start = end - timedelta(days=days)
        url = f"https://efts.sec.gov/LATEST/search-index?q=%22open+market+purchase%22&startdt={start.strftime('%Y-%m-%d')}&enddt={end.strftime('%Y-%m-%d')}&forms=4"
        r = requests.get(url, headers=HEADERS, timeout=15)
        if r.ok:
            data = r.json()
            return {"count": data.get("hits", {}).get("total", {}).get("value", 0),
                    "source": "SEC EDGAR Form 4"}
    except:
        pass
    return {"count": 0, "source": "SEC EDGAR (unavailable)"}

def get_13f_whales(ticker="AAPL"):
    """Check recent 13F filings for institutional position changes."""
    try:
        url = f"https://efts.sec.gov/LATEST/search-index?q=%22{ticker}%22&forms=13F-HR&dateRange=custom"
        end = datetime.now(timezone.utc)
        start = end - timedelta(days=90)
        r = requests.get(f"https://efts.sec.gov/LATEST/search-index?q=%22{ticker}%22&forms=13F-HR&startdt={start.strftime('%Y-%m-%d')}", 
                        headers=HEADERS, timeout=15)
        if r.ok:
            return {"filings": r.json().get("hits", {}).get("total", {}).get("value", 0)}
    except:
        pass
    return {"filings": 0}

def get_fear_greed():
    """Crypto Fear & Greed Index. Extreme fear = buy. Extreme greed = sell."""
    try:
        r = requests.get("https://api.alternative.me/fng/?limit=1", timeout=10)
        if r.ok:
            d = r.json()["data"][0]
            return {"value": int(d["value"]), "label": d["value_classification"]}
    except:
        pass
    return {"value": 50, "label": "Neutral"}

def inversion_analysis(signals):
    """Inversion thinking: What if the consensus signal is WRONG?
    When everyone is bullish → check for exhaustion.
    When everyone is bearish → check for capitulation bottom."""
    bull_count = sum(1 for s in signals.values() if s.get("direction") == "BUY")
    bear_count = sum(1 for s in signals.values() if s.get("direction") == "SELL")
    total = len(signals)
    if total == 0:
        return {"warning": None, "consensus": "NONE"}
    
    bull_pct = bull_count / total
    if bull_pct > 0.8:
        return {"warning": "EXTREME_CONSENSUS_BULL — inversion says watch for reversal",
                "consensus": "BULL", "strength": round(bull_pct, 2),
                "action": "Tighten stops. Consider reducing position sizes 20%."}
    elif bull_pct < 0.2:
        return {"warning": "EXTREME_CONSENSUS_BEAR — inversion says watch for bottom",
                "consensus": "BEAR", "strength": round(1-bull_pct, 2),
                "action": "Look for capitulation volume. Scale into positions slowly."}
    return {"warning": None, "consensus": "MIXED", "strength": round(max(bull_pct, 1-bull_pct), 2)}

class PerformanceTracker:
    """Track every prediction, measure hit rate, adapt over time."""
    LOG_FILE = "/Users/burtonchatelain/.openclaw/workspace/models/prediction_log.json"
    
    def __init__(self):
        self.log = self._load()
    
    def _load(self):
        try:
            with open(self.LOG_FILE) as f:
                return json.load(f)
        except:
            return {"predictions": [], "stats": {}}
    
    def _save(self):
        with open(self.LOG_FILE, "w") as f:
            json.dump(self.log, f, indent=2, default=str)
    
    def record(self, ticker, direction, score, price):
        self.log["predictions"].append({
            "ts": datetime.now(timezone.utc).isoformat(),
            "ticker": ticker, "direction": direction,
            "score": score, "entry_price": price, "exit_price": None, "result": None
        })
        # Keep last 500 predictions
        self.log["predictions"] = self.log["predictions"][-500:]
        self._save()
    
    def update_results(self, prices_dict):
        """Check old predictions against current prices."""
        updated = 0
        for pred in self.log["predictions"]:
            if pred["result"] is not None:
                continue
            ticker = pred["ticker"]
            if ticker in prices_dict and pred["entry_price"]:
                current = prices_dict[ticker]
                entry = pred["entry_price"]
                ret = (current - entry) / entry
                if pred["direction"] == "BUY":
                    pred["result"] = "WIN" if ret > 0.001 else "LOSS"
                elif pred["direction"] == "SELL":
                    pred["result"] = "WIN" if ret < -0.001 else "LOSS"
                pred["exit_price"] = current
                updated += 1
        self._save()
        return updated
    
    def get_stats(self):
        """Calculate hit rate and other performance metrics."""
        resolved = [p for p in self.log["predictions"] if p["result"]]
        if not resolved:
            return {"total": 0, "hit_rate": 0, "wins": 0, "losses": 0}
        wins = sum(1 for p in resolved if p["result"] == "WIN")
        return {
            "total": len(resolved), "wins": wins, "losses": len(resolved)-wins,
            "hit_rate": round(wins/len(resolved)*100, 1),
            "recent_10": sum(1 for p in resolved[-10:] if p["result"]=="WIN") / min(10, len(resolved[-10:])) * 100
        }

def daily_intel_report():
    """Full intelligence briefing."""
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    lines = [f"[ALPHA INTEL] {ts}", ""]
    
    # Fear & Greed
    fg = get_fear_greed()
    lines.append(f"Fear/Greed: {fg['value']} ({fg['label']})")
    if fg["value"] < 25:
        lines.append("  >> EXTREME FEAR — historically best time to buy crypto")
    elif fg["value"] > 75:
        lines.append("  >> EXTREME GREED — consider taking profits")
    
    # SEC insider activity
    insiders = get_insider_buys(7)
    lines.append(f"SEC Insider Buys (7d): {insiders['count']} filings")
    
    # Performance tracking
    tracker = PerformanceTracker()
    stats = tracker.get_stats()
    if stats["total"] > 0:
        lines.append(f"Prediction Track Record: {stats['hit_rate']:.1f}% ({stats['wins']}W/{stats['losses']}L)")
        lines.append(f"  Recent 10: {stats['recent_10']:.0f}%")
    
    # Inversion check (need kernel signals)
    try:
        sys.path.insert(0, "/Users/burtonchatelain/.openclaw/workspace/scripts/integrations")
        from kernel_predictor_v9 import KernelPredictor
        import yfinance as yf
        signals = {}
        for ticker in ["SPY","QQQ","BTC-USD","ETH-USD","SOL-USD"]:
            try:
                p = yf.Ticker(ticker).history(period="6mo")["Close"].values
                kp = KernelPredictor("equity" if "-" not in ticker else "crypto")
                signals[ticker] = kp.predict(p)
            except:
                pass
        inv = inversion_analysis(signals)
        if inv["warning"]:
            lines.append(f"INVERSION ALERT: {inv['warning']}")
            lines.append(f"  Action: {inv['action']}")
        else:
            lines.append(f"Consensus: {inv['consensus']} (no inversion trigger)")
    except Exception as e:
        lines.append(f"Inversion check error: {e}")
    
    return "\n".join(lines)

if __name__ == "__main__":
    print(daily_intel_report())
