	<item>
		<title>PROTECTING THE EXECUTIVE&#8217;S PRIVILEGES AND ENHANCING EFFICIENCIES IN FEDERAL CONTRACTING</title>
		<link>https://www.whitehouse.gov/presidential-actions/2026/11/protecting-the-executives-privileges-and-enhancing-efficiencies-in-federal-contracting/</link>
		
		<dc:creator><![CDATA[The White House]]></dc:creator>
		<pubDate>Sat, 21 Nov 2026 02:31:05 +0000</pubDate>
				<category><![CDATA[Presidential Actions]]></category>
